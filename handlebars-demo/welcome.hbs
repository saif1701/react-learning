<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f4;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">

          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="background:#ffffff;"
          >

            <tr>
              <td align="center" style="padding:30px;">
                <img
                  src="https://placehold.co/150x80"
                  alt="Logo"
                  style="display:block;border:0;"
                />
              </td>
            </tr>

            <tr>
              <td style="padding:40px;text-align:center;">

                <h1>Hello {{name}}</h1>

                <p>
                  Welcome to our company.
                </p>

                {{#if premium}}

                  <p style="color:green;">
                    Premium Member
                  </p>

                {{else}}

                  <p style="color:red;">
                    Free Member
                  </p>

                {{/if}}

                <table
                  align="center"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                >

                  <tr>

                    <td bgcolor="#0d6efd">

                      <a
                        href="{{verifyLink}}"
                        style="
display:inline-block;
padding:15px 30px;
text-decoration:none;
color:white;
font-weight:bold;
"
                      >

                        Verify Email

                      </a>

                    </td>

                  </tr>

                </table>

              </td>

            </tr>

          </table>

        </td>

      </tr>

    </table>

  </body>
</html>