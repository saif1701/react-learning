<html>
  <head>
    <title>Welcome Email</title>
  </head>
  <body>

    <h1>Hello {{name}}</h1>

    {{#if premium}}

      <p>Thank you for being a Premium Member.</p>

    {{else}}

      <p>Upgrade to Premium today!</p>

    {{/if}}

    <h2>Products</h2>

    {{#each products}}

      <p>{{name}} - ₹{{price}}</p>

    {{/each}}

    <p>Welcome to ABC Company.</p>

    <a href="{{verifyLink}}">
      Verify Email
    </a>

  </body>
</html>